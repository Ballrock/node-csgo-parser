{
  "name": "node-csgo-parser",
  "version": "0.0.4",
  "description": "Extract Items/Skins/... from raw VDF data files",
  "main": "lib/csgo-data-parser.js",
  "readmeFilename": "README.md",
  "private": false,
  "directories": {},
  "repository": {
    "type": "git",
    "url": "git://github.com/Ballrock/node-csgo-parser.git"
  },
  "dependencies": {
    "vdf": "^0.0.2",
    "winston": "^2.1.1"
  },
  "devDependencies": {
    "babel-cli": "^6.4.0",
    "babel-preset-es2015": "^6.3.13",
    "chai": "^4.3.10",
    "istanbul": "^0.4.1",
    "jsdoc": "^3.4.0",
    "jsdoc-to-markdown": "^1.3.2",
    "minami": "^1.1.1",
    "mocha": "^10.0.0",
    "mocha-junit-reporter": "^2.2.0"
  },
  "scripts": {
    "example": "node example.js",
    "test": "mocha ./test/*.js",
    "test:ci": "mocha ./test/*.js --reporter mocha-junit-reporter --reporter-options mochaFile=./test-results/junit.xml --timeout 10000 --exit",
    "generate-docs": "node_modules/.bin/jsdoc --configure .jsdoc.json --verbose",
    "generate-docs-md": "node_modules/.bin/jsdoc2md \"src/csgo-data-parser.js\" > out/docs/api.md",
    "compile": "babel --presets es2015 src -d lib"
  },
  "keywords": [
    "csgo",
    "skins",
    "counter-strike",
    "steam",
    "valve"
  ],
  "author": "Ballrock",
  "license": "ISC"
}
